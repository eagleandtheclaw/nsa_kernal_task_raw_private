<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eagleandtheclaw.nsa-kernal-task.capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Library/Application Support/nsa_kernal_task/capture.py</string>
    <string>loop</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>23</integer>
  <key>StandardOutPath</key><string>/var/db/nsa_kernal_task/capture.stdout.log</string>
  <key>StandardErrorPath</key><string>/var/db/nsa_kernal_task/capture.stderr.log</string>
</dict>
</plist>
